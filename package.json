{
  "name": "drivek-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation portfolio for the public DriveK automotive website",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}